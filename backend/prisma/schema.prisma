generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Family {
  id          String       @id @default(uuid())
  name        String
  inviteCode  String       @unique
  createdAt   DateTime     @default(now())
  users       User[]
  lists       List[]
  recipes     Recipe[]
  mealPlans   MealPlan[]
  products    Product[]
  supermarkets Supermarket[]
  invites     FamilyInvite[]
}

model FamilyInvite {
  id        String    @id @default(uuid())
  familyId  String
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    String?
}

model Product {
  id         String          @id @default(uuid())
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  category   String          @default("General")
  unit       String          @default("u")
  createdAt  DateTime        @default(now())
  prices     ProductPrice[]

  @@unique([familyId, name])
}

model Supermarket {
  id         String          @id @default(uuid())
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime        @default(now())
  prices     ProductPrice[]

  @@unique([familyId, name])
}

model ProductPrice {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supermarketId  String
  supermarket    Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  price          String
  recordedAt     DateTime    @default(now())

  @@unique([productId, supermarketId])
}

model User {
  id       String   @id @default(uuid())
  username String   @unique
  password String
  name     String
  role     String   @default("member")
  familyId String?
  family   Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  permissions Json?
  lists    ListMember[]
  createdAt DateTime @default(now())
}

model List {
  id         String       @id @default(uuid())
  name       String
  icon       String       @default("shopping-bag")
  color      String       @default("emerald")
  type       String       @default("shopping")
  familyId   String
  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ownerId    String?
  visibility String       @default("family")
  pinned     Boolean      @default(false)
  order      Int          @default(0)
  items      ListItem[]
  members    ListMember[]
  createdAt  DateTime     @default(now())
}

model ListMember {
  id     String @id @default(uuid())
  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

model ListItem {
  id         String        @id @default(uuid())
  listId     String
  list       List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  name       String
  quantity   String        @default("1")
  category   String        @default("General")
  price      String        @default("")
  note       String        @default("")
  assigneeId String?
  dueDate    String?
  priority   String?
  status     String        @default("pendiente")
  completed  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  priceHistory PriceEntry[]
}

model PriceEntry {
  id         String   @id @default(uuid())
  itemId     String
  item       ListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price      String
  recordedAt DateTime @default(now())
}

model Recipe {
  id           String       @id @default(uuid())
  familyId     String
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  prepTime     String?
  servings     Int          @default(4)
  instructions String?
  ingredients  Ingredient[]
  mealPlans    MealPlan[]
  createdAt    DateTime     @default(now())
}

model Ingredient {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  amount   String
  unit     String
}

model MealPlan {
  id          String   @id @default(uuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  mealType    String   // Desayuno, Almuerzo, Cena, Snack
  recipeId    String?
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  customTitle String?
  createdAt   DateTime @default(now())
}
